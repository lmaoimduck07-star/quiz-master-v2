rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc công khai cài đặt hệ thống để phát hiện trạng thái bảo trì ngay cả khi chưa đăng nhập
    match /systemSettings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Các tài nguyên khác yêu cầu đăng nhập
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
